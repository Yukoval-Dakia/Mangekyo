# Mangekyō 私有单机部署环境变量模板
# 复制为 deploy/.env 后填写真实值。deploy/.env 已被 .gitignore 的 .env* 规则忽略，不会入库。
# 与源码 100% 对齐：所有变量名均可在 runtime/studio/server.ts、runtime/studio/*.ts、
# executors/temporal/src/run-worker.ts、executors/python-deriver/host.ts、
# executors/document-extraction/local.ts、executors/teaching/provider-settings.ts 中找到。

# ---------- PostgreSQL（compose 服务 postgres） ----------
# 数据库名、用户名、密码。密码必须足够强；不要使用默认弱口令上线。
POSTGRES_DB=mangekyo
POSTGRES_USER=mangekyo
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
# 宿主机映射端口（仅 loopback）。
POSTGRES_PORT=55432

# ---------- Temporal（compose 服务 temporal） ----------
# Temporal 服务地址。compose 内部为 temporal:7233；宿主机访问为 127.0.0.1:${TEMPORAL_PORT}。
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_PORT=7423
TEMPORAL_UI_PORT=8423

# ---------- Studio / Web / Worker ----------
# Studio HTTP 端口（仅 loopback）。
STUDIO_PORT=4317
# 进程角色：studio（默认，同时起 Web + Worker）、web（仅 Web）、worker（仅 Worker）。
MANGEKYO_PROCESS=studio
# 内核 schema 名。默认 mangekyo_studio；测试/验收可用 test_<id>。
MANGEKYO_DATABASE_SCHEMA=mangekyo_studio
# 任务队列前缀。Worker 实际队列为 <MANGEKYO_TASK_QUEUE>-<store_id>。
MANGEKYO_TASK_QUEUE=mangekyo-studio
# 构建 ID。开发环境留空由源码指纹自动生成；发行环境必须显式设置唯一值。
# MANGEKYO_BUILD_ID=
# 本机开发自动激活构建版本（仅限开发/验收，生产不要设）。
# MANGEKYO_ACTIVATE_LOCAL_BUILD=1

# ---------- 原件/Blob 存储 ----------
# 交入原件根目录。compose 中为 /data/intake（持久卷 intakedata）。
# 宿主机直接运行时默认为 ~/.local/share/mangekyo/intake 或平台对应目录。
# MANGEKYO_INTAKE_DATA_DIR=
# 模型供应商与 MCP 路由配置文件。compose 中为 /data/config/provider.json。
# MANGEKYO_SETTINGS_FILE=
# 学习工作区访问路由文件。compose 中为 /data/config/workspace-access.json。
# MANGEKYO_WORKSPACE_ACCESS_FILE=

# ---------- 可选供应商与外部服务 ----------
# 模型服务（OpenAI 兼容或 Anthropic Messages）。默认本机 Magpie http://127.0.0.1:3425/v1。
# 也可在 Studio「模型设置」中保存多套配置；环境变量仅作首次默认。
# MANGEKYO_LLM_BASE_URL=http://127.0.0.1:3425/v1
# MANGEKYO_LLM_API_KEY=
# Exa 公共额度或单独 API 密钥。
# MANGEKYO_EXA_API_KEY=
# EXA_API_KEY=
# MinerU 云识别 token（可选；不设则本地抽取为默认）。
# MANGEKYO_MINERU_TOKEN=
# Notion 集成 token（可选）。
# MANGEKYO_NOTION_TOKEN=

# ---------- 可选本机模块/执行器 ----------
# Python 计算沙箱镜像由 executors/teaching/agent-tools.ts 固定为 mangekyo-calculation:1。
# Python 解释器路径（python-deriver host 使用）。默认 python3。
# MANGEKYO_PYTHON=
# 本机 Swift 工具链路径（document-extraction 本地抽取使用）。默认 swift。
# MANGEKYO_SWIFT=
# IQDB 本机核验模块（可选；需包含 solve-1/2/3/contract 四个 .wasm 绝对路径的 JSON）。
# MANGEKYO_IQDB_LOCAL_WASM=
# 保持方法覆盖（默认 cognition@3）。
# MANGEKYO_RETENTION_METHOD=
# 首轮 JIT 计数模块（可选）。
# MANGEKYO_STUDIO_JIT_MODULE=
# 开启 JIT（默认关闭）。
# MANGEKYO_STUDIO_ENABLE_JIT=1
# 教学理解模块（可选）。
# MANGEKYO_UNDERSTANDING_MODULE=
# 研究侦察模块（可选）。
# MANGEKYO_RESEARCH_SCOUT_MODULE=
# 研究工作者费率模块（可选）。
# MANGEKYO_RESEARCH_WORKER_TARIFF=
# 工作簿评估宿主模块（可选）。
# MANGEKYO_WORKBOOK_ASSESSMENT_MODULE=
# 作品评估宿主模块（可选）。
# MANGEKYO_ARTIFACT_ASSESSMENT_MODULE=
# Notion 测试起源（仅测试/验收，生产不要设）。
# MANGEKYO_NOTION_TEST_ORIGIN=

# ---------- 测试/验收专用（生产不要设） ----------
# 真实 PostgreSQL 集成测试连接串。
# MANGEKYO_TEST_DATABASE_URL=postgresql://user:pass@127.0.0.1:55432/mangekyo
# 作品评估验收数据库与 Temporal 地址。
# MANGEKYO_ARTIFACT_ACCEPTANCE_DATABASE_URL=
# MANGEKYO_ARTIFACT_ACCEPTANCE_TEMPORAL=
# 回忆验收 PG 连接串。
# MANGEKYO_RECALL_LOCAL_PG=
# 采集验收 PG 连接串（缺省回落 MANGEKYO_TEST_DATABASE_URL）。
# MANGEKYO_CAPTURE_ACCEPTANCE_URL=
