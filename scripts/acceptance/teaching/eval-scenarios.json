  "scenarios": [
    {
      "id": "bridge-three-sources",
      "title": "三种旧知桥接都能回到当前一步",
      "category": "skill_bridge",
      "rubricFocus": ["bridge_truthfulness", "extension_hook", "tool_efficiency"],
      "signals": {"proactivityExpected": "balanced", "expectedSkills": ["knowledge-bridge"], "hasMasteredBridge": true, "hasNotionBridge": true, "hasOldMistakeBridge": true},
      "userInput": "我会列动量守恒式，但总在最后一步把速度方向弄反。",
      "mockContext": {"bridge": {"masteredProblem": {"id": "m1", "rev": 2, "text": "梯子题中先固定正方向再列守恒式。"}, "notion": {"id": "n1", "rev": 4, "text": "笔记约定向右为正。"}, "oldMistake": {"id": "o1", "rev": 1, "text": "上次把碰撞后的速度方向直接当成正值。"}}},
      "mustExhibit": [{"id": "cite-three", "description": "只引用三个已提供桥接来源", "pattern": "m1|n1|o1", "rubricDimension": "bridge_truthfulness"}, {"id": "one-hook", "description": "给一个紧邻的方向检查钩子", "pattern": "方向|正方向", "rubricDimension": "extension_hook"}],
      "mustAvoid": [{"id": "invent-history", "description": "不得编造未给出的旧作", "pattern": "三年前|你一直|肯定还记得", "rubricDimension": "bridge_truthfulness"}, {"id": "serial-read", "description": "不得串行反复查找", "pattern": "再查一次|继续搜索", "rubricDimension": "tool_efficiency"}]
    },
    {
