      "signals": {"proactivityExpected": "balanced", "expectedSkills": ["boundary-probe"], "nearMiss": true, "highConfidenceWrong": true},
      "userInput": "我很确定摩擦力总是和运动方向相反。",
      "mockContext": {"question": {"text": "物体有外力推动但仍静止。", "answerHidden": true}, "studentConfidence": "high", "observedError": "把静摩擦方向当成固定规则"},
      "mustExhibit": [{"id": "minimal-counterexample", "description": "提出不泄答案的最小条件反转", "pattern": "静止|趋势|可能向左|可能向右", "rubricDimension": "extension_hook"}],
      "mustAvoid": [{"id": "give-answer", "description": "不得提前给完整受力结论", "pattern": "标准答案|完整解析|摩擦力就是", "rubricDimension": "boundary_respect"}]
    },
