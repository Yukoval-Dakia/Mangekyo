{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mangekyo:CanonicalEvidenceSlice:v1",
  "x-derivers": {
    "learner/intervention-lift@1": "intervention-lift@1",
    "plan/exam-pacing@1": "plan/exam-pacing@1",
    "plan/exam-pacing@2": "plan/exam-pacing@2",
    "learner/cognition@3": "cognition@3",
    "plan/information-gain@1": "plan/information-gain@1",
    "learner/cognition@2": "cognition@2",
    "learner/cognition@1": "cognition@1",
    "learner/retention-forecast@1": "dimensioned-retention@1"
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "refs": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "time": { "type": "string", "format": "date-time" },
    "nonnegative": { "type": "number", "minimum": 0 },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "novelty": { "enum": ["same", "isomorphic", "transfer"] },
    "errorStage": { "enum": ["reading", "modeling", "strategy", "execution", "expression"] },
    "state": { "enum": ["known", "unknown"] },
    "methodVersion": { "enum": ["cognition@1", "cognition@2", "cognition@3", "dimensioned-retention@1"] },
    "dimension": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
    "evidenceRef": {
      "type": "object", "additionalProperties": false, "required": ["ref", "rev"],
      "properties": { "ref": { "$ref": "#/$defs/text" }, "rev": { "$ref": "#/$defs/revision" } }
    },
    "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
    "examScore": {
      "type": "object", "additionalProperties": false, "required": ["earned", "maximum"],
      "properties": {
        "earned": { "$ref": "#/$defs/nonnegative" },
        "maximum": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "omission": {
      "type": "object", "additionalProperties": false, "required": ["ref", "reason"],
      "properties": {
        "ref": {
          "type": "object", "additionalProperties": false, "required": ["id", "rev"],
          "properties": { "id": { "$ref": "#/$defs/text" }, "rev": { "$ref": "#/$defs/revision" } }
        },
        "item_id": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "factRefV2": {
      "type": "object", "additionalProperties": false, "required": ["id", "rev"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "rev": { "$ref": "#/$defs/revision" } }
    },
    "inputRefV2": {
      "type": "object", "additionalProperties": false, "required": ["slot_id", "path"],
      "properties": { "slot_id": { "$ref": "#/$defs/text" }, "path": { "type": "string" } }
    },
    "kcLinkV2": {
      "type": "object", "additionalProperties": false, "required": ["kc_id", "weight", "role", "source"],
      "properties": {
        "kc_id": { "$ref": "#/$defs/text" },
        "weight": { "$ref": "#/$defs/probability" },
        "role": { "enum": ["target", "prerequisite"] },
        "source": { "enum": ["authored", "verified_edge", "question_fallback"] }
      }
    },
    "criterionV2": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "input_refs", "earned", "maximum", "outcome", "kc_links", "evaluator"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/text" },
        "input_refs": { "type": "array", "items": { "$ref": "#/$defs/inputRefV2" } },
        "earned": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "maximum": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "outcome": { "enum": ["correct", "incorrect", "partial", "unknown"] },
        "score_norm": { "$ref": "#/$defs/probability" },
        "interaction": { "enum": ["conjunctive", "compensatory"] },
        "kc_links": { "type": "array", "items": { "$ref": "#/$defs/kcLinkV2" } },
        "evaluator": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": { "id": { "$ref": "#/$defs/text" }, "version": { "$ref": "#/$defs/text" } }
        },
        "error_stage": { "$ref": "#/$defs/errorStage" }
      }
    },
    "itemModelV2": {
      "type": "object", "additionalProperties": false,
      "required": ["discrimination", "difficulty", "guess", "slip", "source"],
      "properties": {
        "discrimination": { "type": "number", "minimum": 0.25, "maximum": 4 },
        "difficulty": { "type": "number", "minimum": -6, "maximum": 6 },
        "guess": { "type": "number", "minimum": 0, "maximum": 0.4 },
        "slip": { "type": "number", "minimum": 0, "maximum": 0.4 },
        "source": { "enum": ["calibrated", "population_prior"] }
      }
    },
    "conceptNodeV2": {
      "type": "object", "additionalProperties": false, "required": ["kc_id", "kli_profile"],
      "properties": {
        "kc_id": { "$ref": "#/$defs/text" },
        "kli_profile": { "enum": ["memory_discrimination", "procedural_fluency", "principle_intuition", "open_construction"] },
        "study_stage": { "enum": ["learned", "current", "not_started", "excluded"] },
        "target_level": { "enum": ["school", "exam", "selective", "olympiad"] }
      }
    },
    "conceptEdgeV2": {
      "type": "object", "additionalProperties": false, "required": ["from_kc_id", "to_kc_id", "kind", "weight", "verified", "ref"],
      "properties": {
        "from_kc_id": { "$ref": "#/$defs/text" },
        "to_kc_id": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["prereq_of", "confuses_with", "subskill_of"] },
        "weight": { "$ref": "#/$defs/probability" },
        "verified": { "type": "boolean" },
        "ref": { "$ref": "#/$defs/factRefV2" }
      }
    },
    "authorizationInputV2": {
      "type": "object", "additionalProperties": false, "required": ["ref", "access_epoch", "mode", "sticky"],
      "properties": {
        "ref": { "$ref": "#/$defs/factRefV2" },
        "access_epoch": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])" },
        "mode": { "enum": ["pinned", "following", "asof"] },
        "sticky": { "type": "boolean" }
      }
    },
    "itemPacing": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_ref", "paper_key", "item_id", "position", "item_count"],
      "properties": {
        "attempt_ref": { "type": "object", "additionalProperties": false, "required": ["id", "rev"],
          "properties": { "id": { "$ref": "#/$defs/text" }, "rev": { "$ref": "#/$defs/revision" } } },
        "paper_key": { "$ref": "#/$defs/text" }, "item_id": { "$ref": "#/$defs/text" },
        "position": { "$ref": "#/$defs/revision" }, "item_count": { "$ref": "#/$defs/revision" },
        "skipped": { "const": true }, "returned": { "const": true },
        "estimated_duration_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "scale_key": { "$ref": "#/$defs/text" }, "score": { "$ref": "#/$defs/examScore" }
      },
      "not": { "type": "object", "required": ["returned"], "not": { "type": "object", "required": ["skipped"] } },
      "anyOf": [{ "type": "object", "not": { "anyOf": [{ "type": "object", "required": ["score"] }, { "type": "object", "required": ["scale_key"] }] } },
                { "type": "object", "required": ["score", "scale_key"] }]
    },
    "itemHelp": { "enum": ["independent", "hinted", "hint_l1", "hint_l2", "solution_seen"] },
    "event": {
      "anyOf": [
        { "type": "object", "properties": { "help_level": { "$ref": "#/$defs/itemHelp" } },
          "not": { "type": "object", "required": ["exam_pacing_item"] } },
        { "type": "object", "anyOf": [
          { "type": "object", "required": ["exam_pacing"] },
          { "type": "object", "required": ["exam_pacing_item"], "not": { "type": "object", "required": ["score_norm"] }, "properties": { "claim_ids": { "type": "array", "maxItems": 0 } } }
        ], "not": { "type": "object", "required": ["exam_pacing", "exam_pacing_item"] }, "properties": {
          "help_level": { "enum": ["unknown"] }, "outcome": { "enum": ["unknown"] },
          "concept_ids": { "type": "array", "maxItems": 0 }
        } }
      ],
      "type": "object", "additionalProperties": false,
      "required": ["ref", "rev", "occurred_at", "concept_ids", "item_novelty", "help_level", "outcome", "claim_ids"],
      "properties": {
        "ref": { "$ref": "#/$defs/text" },
        "rev": { "$ref": "#/$defs/revision" },
        "occurred_at": { "$ref": "#/$defs/time" },
        "concept_ids": { "$ref": "#/$defs/refs" },
        "item_novelty": { "$ref": "#/$defs/novelty" },
        "help_level": { "$ref": "#/$defs/text" },
        "outcome": { "enum": ["correct", "incorrect", "partial", "unknown"] },
        "score_norm": { "$ref": "#/$defs/probability" },
        "effective_duration_ms": { "$ref": "#/$defs/nonnegative" },
        "confidence": { "$ref": "#/$defs/probability" },
        "error_stage": { "$ref": "#/$defs/errorStage" },
        "fact_ref": { "$ref": "#/$defs/factRefV2" },
        "item_id": { "$ref": "#/$defs/text" },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterionV2" } },
        "attribution_status": { "enum": ["criterion", "single_kc_fallback", "question_fallback", "unknown"] },
        "item_model": { "$ref": "#/$defs/itemModelV2" },
        "exam_pacing_item": { "$ref": "#/$defs/itemPacing" },
        "exam_pacing": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "paper_key": { "$ref": "#/$defs/text" },
            "scale_key": { "$ref": "#/$defs/text" },
            "score": { "$ref": "#/$defs/examScore" }
          }
        },
        "claim_ids": { "$ref": "#/$defs/refs" },
        "representation": { "$ref": "#/$defs/text" },
        "context": { "$ref": "#/$defs/text" },
        "method": { "$ref": "#/$defs/text" }
      }
    },
    "deadline": {
      "type": "object", "additionalProperties": false, "required": ["ref", "at"],
      "properties": { "ref": { "$ref": "#/$defs/text" }, "at": { "$ref": "#/$defs/time" } }
    },
    "constraints": {
      "type": "object", "additionalProperties": false, "required": ["budget_min", "locks", "deadlines"],
      "properties": {
        "budget_min": { "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }] },
        "locks": { "$ref": "#/$defs/refs" },
        "deadlines": { "type": "array", "items": { "$ref": "#/$defs/deadline" } }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "concept_ids", "item_novelty", "est_min"],
      "properties": {
        "ref": { "$ref": "#/$defs/text" },
        "concept_ids": { "$ref": "#/$defs/refs" },
        "item_novelty": { "$ref": "#/$defs/novelty" },
        "est_min": { "type": "number", "exclusiveMinimum": 0 },
        "item_id": { "$ref": "#/$defs/text" },
        "item_model": { "$ref": "#/$defs/itemModelV2" },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/kcLinkV2" } },
        "representation": { "$ref": "#/$defs/text" },
        "context": { "$ref": "#/$defs/text" },
        "method": { "$ref": "#/$defs/text" }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["clock_watermark", "as_of_at", "events", "constraints", "candidate_pool"],
      "properties": {
        "schema_version": { "enum": ["v2"] },
        "clock_watermark": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])" },
        "as_of_at": { "$ref": "#/$defs/time" },
        "authorization": {
          "type": "object", "additionalProperties": false, "required": ["purpose", "recipient_id", "inputs"],
          "properties": {
            "purpose": { "$ref": "#/$defs/refs" },
            "recipient_id": { "$ref": "#/$defs/text" },
            "inputs": { "type": "array", "items": { "$ref": "#/$defs/authorizationInputV2" } }
          }
        },
        "concept_graph": {
          "type": "object", "additionalProperties": false, "required": ["nodes", "edges"],
          "properties": {
            "nodes": { "type": "array", "items": { "$ref": "#/$defs/conceptNodeV2" } },
            "edges": { "type": "array", "items": { "$ref": "#/$defs/conceptEdgeV2" } }
          }
        },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "omissions": { "type": "array", "items": { "$ref": "#/$defs/omission" } },
        "constraints": { "$ref": "#/$defs/constraints" },
        "candidate_pool": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }
      }
    },
    "unknownUncertainty": {
      "type": "object", "additionalProperties": false, "required": ["kind", "reason", "needed"],
      "properties": {
        "kind": { "enum": ["unknown"] },
        "reason": { "$ref": "#/$defs/text" },
        "needed": { "$ref": "#/$defs/text" }
      }
    },
    "intervalUncertainty": {
      "type": "object", "additionalProperties": false, "required": ["kind", "low", "high"],
      "properties": {
        "kind": { "enum": ["interval"] },
        "low": { "$ref": "#/$defs/probability" },
        "high": { "$ref": "#/$defs/probability" }
      }
    },
    "unknownDimension": {
      "type": "object", "additionalProperties": false,
      "required": ["concept_id", "representation", "context", "method", "item_novelty", "state", "uncertainty", "evidence_refs"],
      "properties": {
        "concept_id": { "$ref": "#/$defs/text" },
        "representation": { "$ref": "#/$defs/dimension" },
        "context": { "$ref": "#/$defs/dimension" },
        "method": { "$ref": "#/$defs/dimension" },
        "item_novelty": { "$ref": "#/$defs/novelty" },
        "state": { "enum": ["unknown"] },
        "uncertainty": { "$ref": "#/$defs/unknownUncertainty" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "knownDimension": {
      "type": "object", "additionalProperties": false,
      "required": ["concept_id", "representation", "context", "method", "item_novelty", "state", "uncertainty", "evidence_refs", "mastery_prob", "r_now", "stability_days", "difficulty", "effective_evidence", "interval_days", "last_at"],
      "properties": {
        "concept_id": { "$ref": "#/$defs/text" },
        "representation": { "$ref": "#/$defs/dimension" },
        "context": { "$ref": "#/$defs/dimension" },
        "method": { "$ref": "#/$defs/dimension" },
        "item_novelty": { "$ref": "#/$defs/novelty" },
        "state": { "enum": ["known"] },
        "uncertainty": { "$ref": "#/$defs/intervalUncertainty" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "mastery_prob": { "$ref": "#/$defs/probability" },
        "r_now": { "$ref": "#/$defs/probability" },
        "stability_days": { "type": "number", "exclusiveMinimum": 0 },
        "difficulty": { "$ref": "#/$defs/probability" },
        "effective_evidence": { "$ref": "#/$defs/nonnegative" },
        "interval_days": { "type": "array", "items": { "$ref": "#/$defs/nonnegative" } },
        "last_at": { "$ref": "#/$defs/time" },
        "crossing_at": { "$ref": "#/$defs/time" }
      }
    },
    "rankedCandidate": {
      "type": "object", "additionalProperties": false, "required": ["ref", "info_gain", "est_min", "reason_code"],
      "properties": {
        "ref": { "$ref": "#/$defs/text" },
        "info_gain": { "$ref": "#/$defs/nonnegative" },
        "est_min": { "type": "number", "exclusiveMinimum": 0 },
        "reason_code": { "$ref": "#/$defs/text" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "informationGainResult": {
      "type": "object", "additionalProperties": false,
      "required": ["method_version", "ranked_candidates"],
      "properties": {
        "method_version": { "enum": ["plan/information-gain@1"] },
        "ranked_candidates": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ref", "est_min", "info_gain", "reason_code", "uncertainty"],
            "properties": {
              "ref": { "$ref": "#/$defs/text" },
              "est_min": { "type": "number", "exclusiveMinimum": 0 },
              "info_gain": { "$ref": "#/$defs/probability" },
              "reason_code": { "enum": ["probe-unknown", "reduce-uncertainty"] },
              "uncertainty": {
                "anyOf": [{ "$ref": "#/$defs/intervalUncertainty" }, { "$ref": "#/$defs/unknownUncertainty" }]
              }
            }
          }
        }
      }
    },
    "anomaly": {
      "type": "object", "additionalProperties": false, "required": ["type", "refs"],
      "properties": {
        "type": { "$ref": "#/$defs/text" },
        "refs": { "$ref": "#/$defs/refs" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "error_stage": { "$ref": "#/$defs/errorStage" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["method_version", "state", "state_vector", "uncertainty", "ranked_candidates", "anomalies"],
      "properties": {
        "method_version": { "$ref": "#/$defs/methodVersion" },
        "state": { "$ref": "#/$defs/state" },
        "state_vector": {
          "type": "array", "items": {
            "anyOf": [{ "$ref": "#/$defs/knownDimension" }, { "$ref": "#/$defs/unknownDimension" }]
          }
        },
        "r_now": { "$ref": "#/$defs/probability" },
        "crossing_at": { "$ref": "#/$defs/time" },
        "uncertainty": {
          "anyOf": [{ "$ref": "#/$defs/intervalUncertainty" }, { "$ref": "#/$defs/unknownUncertainty" }]
        },
        "ranked_candidates": { "type": "array", "items": { "$ref": "#/$defs/rankedCandidate" } },
        "anomalies": { "type": "array", "items": { "$ref": "#/$defs/anomaly" } },
        "artifacts": { "type": "array", "items": { "type": "string", "pattern": "^@calc_.+$(?![\\s\\S])" } }
      }
    }
  }
}
